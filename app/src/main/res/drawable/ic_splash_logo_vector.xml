<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Splash icon mark fits cleanly within the Android 12+ inner circular safe zone (radius 36 around 54,54) -->

    <!-- Soft ambient winter glow halo -->
    <group
        android:name="splash_glow_group"
        android:pivotX="54"
        android:pivotY="54">
        <path android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="32"
                    android:type="radial">
                    <item android:color="#4087CFF9" android:offset="0.0" />
                    <item android:color="#1A5A8BB5" android:offset="0.60" />
                    <item android:color="#000B1526" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Sweeping abstract snowstorm wind ribbon -->
        <path android:pathData="M26,62 C38,52 55,65 82,51 C69,65 48,68 26,62 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="26"
                    android:startY="60"
                    android:endX="82"
                    android:endY="51"
                    android:type="linear">
                    <item android:color="#1A87CFF9" android:offset="0.0" />
                    <item android:color="#88CFEAFF" android:offset="0.50" />
                    <item android:color="#2487CFF9" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Hero snow puff cluster (scales softly into focus) -->
    <group
        android:name="splash_primary_puff"
        android:pivotX="47"
        android:pivotY="51">
        <path android:pathData="M47,51m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="45.5"
                    android:centerY="49.5"
                    android:gradientRadius="12.5"
                    android:type="radial">
                    <item android:color="#FFFFFFFF" android:offset="0.0" />
                    <item android:color="#EEEDF7FF" android:offset="0.50" />
                    <item android:color="#88BFE2FF" android:offset="0.80" />
                    <item android:color="#00BFE2FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Secondary drifting snow puffs -->
    <group
        android:name="splash_secondary_puffs"
        android:pivotX="54"
        android:pivotY="54">
        <!-- Upper-right soft snow puff -->
        <path android:pathData="M67,42m-9.5,0a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="66.2"
                    android:centerY="41.2"
                    android:gradientRadius="9.8"
                    android:type="radial">
                    <item android:color="#F5FFFFFF" android:offset="0.0" />
                    <item android:color="#C8EBF6FF" android:offset="0.48" />
                    <item android:color="#5CB4DCFF" android:offset="0.78" />
                    <item android:color="#00B4DCFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Lower-right soft snow puff -->
        <path android:pathData="M63.5,64.5m-7.8,0a7.8,7.8 0,1 1,15.6 0a7.8,7.8 0,1 1,-15.6 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="62.8"
                    android:centerY="63.8"
                    android:gradientRadius="8.0"
                    android:type="radial">
                    <item android:color="#EAFFFFFF" android:offset="0.0" />
                    <item android:color="#B2E2F5FF" android:offset="0.50" />
                    <item android:color="#44A8DCFF" android:offset="0.80" />
                    <item android:color="#00A8DCFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Distant snow flecks -->
        <path android:pathData="M35.5,65.5m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="35.5"
                    android:centerY="65.5"
                    android:gradientRadius="5.0"
                    android:type="radial">
                    <item android:color="#CCFFFFFF" android:offset="0.0" />
                    <item android:color="#5CCBE8FF" android:offset="0.55" />
                    <item android:color="#00CBE8FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <path android:pathData="M53.5,34.5m-4.4,0a4.4,4.4 0,1 1,8.8 0a4.4,4.4 0,1 1,-8.8 0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="53.5"
                    android:centerY="34.5"
                    android:gradientRadius="4.4"
                    android:type="radial">
                    <item android:color="#B8FFFFFF" android:offset="0.0" />
                    <item android:color="#50CBE8FF" android:offset="0.55" />
                    <item android:color="#00CBE8FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
